.fvec projection[4]
.fvec uvx
; Where this draw's geometry stands, world px. Zero for everything that
; carries its own world coordinates; a tree instance sets it to the placement
; it is being drawn at, so one carved shape serves every copy of it.
.fvec toff
.constf ones(1.0, 1.0, 1.0, 1.0)
.constf inv255(0.003921569, 0.003921569, 0.003921569, 0.003921569)
.out outpos position
.out outclr color
.out outtc0 texcoord0
.alias inpos v0
.alias inclr v1
.alias intex v2
.proc main
; PICA takes a uniform only as the FIRST source, so stage it in a register.
mov r1, toff
add r0.xyz, inpos, r1
mov r0.w, ones
dp4 outpos.x, projection[0], r0
dp4 outpos.y, projection[1], r0
dp4 outpos.z, projection[2], r0
dp4 outpos.w, projection[3], r0
mul outclr, inv255, inclr
mul r1, uvx, intex
add outtc0, uvx.zwzw, r1
end
.end
