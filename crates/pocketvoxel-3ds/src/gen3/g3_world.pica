; FireRed's world vertex shader (gen3 builds only; GPLv3 + additional terms,
; see LICENSE.md). The shared shader (../vshader.pica) plus the camera-
; following lean of the cook's buildings and prop cards
; (voxelmon/cook/gen3terrain.ts "the lean code").
;
; projection, uvx and toff come first and in vshader.pica's order, so they
; sit in the same registers and main.rs's bind_vertex_uniform calls land on
; them whichever of the two programs is bound.
;
; A vertex whose colour alpha is 255 is drawn exactly as vshader.pica draws
; it. Any other alpha is a lean code, and the colour bytes carry its numbers
; (the host hands them over untinted; the tint comes from g3tint):
;
;   alpha 0..127    a building vertex, shade alpha/127, stored at its upright
;                   pose (lean 0). With A = w/64, K = r/4, B = g + b/256:
;                     y' = y + K (cos t - 1) - T B sin t
;                     z' = z - A sin t
;                   t the facade lean (g3f), T the roof's rise (tan 12).
;   alpha 128..254  a prop card standing upright facing south, its pivot
;                   dx = w/64 west of the vertex; turned to face the camera
;                   and leaned back by the card lean (g3c, g3c2):
;                     x' = x - dx + dx rx + y fx sin c
;                     z' = z      + dx rz + y fz sin c
;                     y' = y cos c
;                   shade (alpha-128)/126.

.fvec projection[4]
.fvec uvx
.fvec toff
; (sin t, cos t - 1, T sin t, 0)
.fvec g3f
; (rx, rz, fx sin c, fz sin c)
.fvec g3c
; (cos c, 0, 0, 0)
.fvec g3c2
; the scene tint, 0..1, w = 1
.fvec g3tint

.constf ones(1.0, 1.0, 1.0, 1.0)
.constf inv255(0.003921569, 0.003921569, 0.003921569, 0.003921569)
; x: a coded vertex's alpha is below, y: a building's alpha is below,
; z: 1/64, w: 1/4
.constf kc(254.5, 127.5, 0.015625, 0.25)
; x: 1/256, y: 1/127, z: 1/126, w: 128
.constf kd(0.00390625, 0.007874016, 0.007936508, 128.0)

.out outpos position
.out outclr color
.out outtc0 texcoord0
.alias inpos v0
.alias inclr v1
.alias intex v2

.proc main
	mov r0, inpos
	mov r2, inpos.wwww
	mov r1, inclr
	mul r10, inv255, inclr
	cmp kc, gt, gt, r1.wwww
	ifc cmp.x
		ifc cmp.y
			; a building vertex
			mul r3, kc.wwww, r1.xxxx
			mul r4, kc.zzzz, r2
			mul r5, kd.xxxx, r1.zzzz
			add r5, r5, r1.yyyy
			mul r6, g3f.yyyy, r3
			mul r7, g3f.zzzz, r5
			add r6, r6, -r7
			add r0.y, r0, r6
			mul r7, g3f.xxxx, r4
			add r0.z, r0, -r7
			mul r8, kd.yyyy, r1.wwww
		.else
			; a prop card
			mul r4, kc.zzzz, r2
			mul r6, g3c.xxxx, r4
			add r6, r6, -r4
			mul r7, g3c.zzzz, r0.yyyy
			add r6, r6, r7
			add r0.x, r0, r6
			mul r6, g3c.yyyy, r4
			mul r7, g3c.wwww, r0.yyyy
			add r6, r6, r7
			add r0.z, r0, r6
			mul r0.y, g3c2.xxxx, r0
			add r8, -kd.wwww, r1.wwww
			mul r8, kd.zzzz, r8
		.end
		mul r10, g3tint, r8
		mov r10.w, ones
	.end
	; PICA takes a uniform only as the FIRST source
	mov r1, toff
	add r0.xyz, r0, r1
	mov r0.w, ones
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	mov outclr, r10
	mul r1, uvx, intex
	add outtc0, uvx.zwzw, r1
	end
.end
