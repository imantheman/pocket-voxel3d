# makerom ROM Spec File for the 3DS CIA build (tools/make_cia.sh).
#
# Shaped to match what working homebrew CIAs actually carry, read back out
# of three of them field by field (3DShell, Meteo3DS and a third) after the
# first cut of this file launched to "The SD card was removed". The
# differences that mattered are called out inline.
#
# Deliberately carries NO boot logo: makerom's `Logo:` field embeds one of
# Nintendo's, and this build ships nothing of theirs.

BasicInfo:
  Title                   : "Pocket Voxel"
  ProductCode             : "CTR-P-PVXL"
  ContentType             : Application

TitleInfo:
  Category                : Application
  # 20-bit unique id in the 0xff000-0xfffff range homebrew takes, so it can
  # never collide with a retail title's.
  UniqueId                : 0xff3d0

Option:
  UseOnSD                 : true
  FreeProductCode         : true
  MediaFootPadding        : false
  EnableCrypt             : false
  EnableCompress          : true

AccessControlInfo:
  CoreVersion             : 2
  DescVersion             : 2
  ReleaseKernelMajor      : "02"
  ReleaseKernelMinor      : "33"

  # Memory: the ordinary application region, and the New 3DS running at
  # its own clock with its cache on -- this port streams maps and keeps a
  # 24 MB pak cache, and every working CIA compared against had both set.
  MemoryType              : Application
  SystemMode              : 64MB
  SystemModeExt           : Legacy
  EnableL2Cache           : true
  CpuSpeed                : 804MHz
  IdealProcessor          : 0
  AffinityMask            : 1
  Priority                : 16
  MaxCpu                  : 0x9E
  HandleTableSize         : 512
  ResourceLimitCategory   : Application

  DisableDebug            : false
  EnableForceDebug        : false
  CanWriteSharedPage      : true
  CanUsePrivilegedPriority: false
  CanUseNonAlphabetAndNumber: true
  PermitMainFunctionArgument: true
  CanShareDeviceMemory    : true
  RunnableOnSleep         : false
  SpecialMemoryArrange    : true
  CanAccessCore2          : true

  # THE FIX. The first cut granted every filesystem bit there is, including
  # CategorySystemApplication and CategoryHomeMenu. Those bits tell the FS
  # module what kind of title it is serving, and an SD-installed title that
  # claims to be a system application is a contradiction it answers with
  # "The SD card was removed" -- the error this build launched to. Every
  # working CIA read for comparison grants only these two. The paks and
  # save.lua live on the card; this is all the card access the game needs.
  FileSystemAccess:
   - DirectSdmc
   - DirectSdmcWrite

  # ARM9 side: nothing beyond what makerom derives from UseOnSD and
  # DirectSdmc (SD application, direct SDMC). The first cut also granted
  # NAND, TWL and card-SPI mounting -- the same over-privilege as the FS
  # bits above, on the side of the system that actually owns the card.
  # Every working CIA read for comparison has exactly 0x300 here.
  IoAccessControl:

  # Memory the process touches directly, which under the Homebrew Launcher
  # it inherited from its host and as its own title has to declare: the
  # DSP's memory for the sound, and VRAM for citro3d's render targets and
  # textures. Absent, the first VRAM write is a fault.
  # The flags are stated so the descriptors come out byte-identical to a
  # working title's (0xff81ff00 0xff81ff80 for the DSP pair, 0xff91f000
  # 0xff91f600 for VRAM); makerom's `:r` does not mean what its name says.
  MemoryMapping:
   - 1ff00000-1ff7ffff
   - 1f000000-1f5fffff:r

  # The user-mode syscall set, 0x01-0x3D. makerom reads the NUMBERS -- the
  # names are labels -- and refuses anything outside 0x00-0xB8.
  SystemCallAccess:
    ControlMemory: 1
    QueryMemory: 2
    ExitProcess: 3
    GetProcessAffinityMask: 4
    SetProcessAffinityMask: 5
    GetProcessIdealProcessor: 6
    SetProcessIdealProcessor: 7
    CreateThread: 8
    ExitThread: 9
    SleepThread: 10
    GetThreadPriority: 11
    SetThreadPriority: 12
    GetThreadAffinityMask: 13
    SetThreadAffinityMask: 14
    GetThreadIdealProcessor: 15
    SetThreadIdealProcessor: 16
    GetCurrentProcessorNumber: 17
    Run: 18
    CreateMutex: 19
    ReleaseMutex: 20
    CreateSemaphore: 21
    ReleaseSemaphore: 22
    CreateEvent: 23
    SignalEvent: 24
    ClearEvent: 25
    CreateTimer: 26
    SetTimer: 27
    CancelTimer: 28
    ClearTimer: 29
    CreateMemoryBlock: 30
    MapMemoryBlock: 31
    UnmapMemoryBlock: 32
    CreateAddressArbiter: 33
    ArbitrateAddress: 34
    CloseHandle: 35
    WaitSynchronization1: 36
    WaitSynchronizationN: 37
    SignalAndWait: 38
    DuplicateHandle: 39
    GetSystemTick: 40
    GetHandleInfo: 41
    GetSystemInfo: 42
    GetProcessInfo: 43
    GetThreadInfo: 44
    ConnectToPort: 45
    SendSyncRequest1: 46
    SendSyncRequest2: 47
    SendSyncRequest3: 48
    SendSyncRequest4: 49
    SendSyncRequest: 50
    OpenProcess: 51
    OpenThread: 52
    GetProcessId: 53
    GetProcessIdOfThread: 54
    GetThreadId: 55
    GetResourceLimit: 56
    GetResourceLimitLimitValues: 57
    GetResourceLimitCurrentValues: 58
    GetThreadContext: 59
    Break: 60
    OutputDebugString: 61

  InterruptNumbers:

  # What libctru and this port ask srv for: graphics, sound, input, the
  # card, the config, and the wireless the CABLE CLUB uses both ways (UDS
  # between consoles, sockets to an emulator on the same network).
  ServiceAccessControl:
   - APT:U
   - ac:u
   - am:net
   - boss:U
   - cam:u
   - cecd:u
   - cfg:nor
   - cfg:u
   - csnd:SND
   - dsp::DSP
   - frd:u
   - fs:USER
   - gsp::Gpu
   - gsp::Lcd
   - hid:USER
   - http:C
   - ir:rst
   - ir:u
   - ir:USER
   - mic:u
   - ndm:u
   - news:u
   - nwm::EXT
   - nwm::UDS
   - ptm:sysm
   - ptm:u
   - pxi:dev
   - soc:U
   - ssl:C
   - y2r:u

SystemControlInfo:
  SaveDataSize            : 0KB
  RemasterVersion         : 0
  StackSize               : 0x40000
  # The system modules the title depends on. Every working CIA lists these
  # thirty; the first cut listed none.
  Dependency:
    ac: 0x0004013000002402
    am: 0x0004013000001502
    boss: 0x0004013000003402
    camera: 0x0004013000001602
    cecd: 0x0004013000002602
    cfg: 0x0004013000001702
    codec: 0x0004013000001802
    csnd: 0x0004013000002702
    dlp: 0x0004013000002802
    dsp: 0x0004013000001a02
    friends: 0x0004013000003202
    gpio: 0x0004013000001b02
    gsp: 0x0004013000001c02
    hid: 0x0004013000001d02
    http: 0x0004013000002902
    i2c: 0x0004013000001e02
    ir: 0x0004013000003302
    mcu: 0x0004013000001f02
    mic: 0x0004013000002002
    ndm: 0x0004013000002b02
    news: 0x0004013000003502
    nwm: 0x0004013000002c02
    pdn: 0x0004013000002d02
    pm: 0x0004013000002102
    ps: 0x0004013000003102
    ptm: 0x0004013000002202
    qtm: 0x0004013000003702
    ro: 0x0004013000002e02
    socket: 0x0004013000002302
    ssl: 0x0004013000002f02
